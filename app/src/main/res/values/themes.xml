<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, fixed, no action bar. The cover art is the window background while the app opens. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorBackground">@color/app_bg</item>
    </style>
</resources>
